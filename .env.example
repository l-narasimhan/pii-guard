# demo = chat page + /vault on (local only!)   prod = both off
PII_MODE=prod
# required in prod: callers send header  X-API-Key: <value>
PII_API_KEY=change-me
# where to download the model from when /app/models/tagger is empty (private repo needs a token)
PII_MODEL_REPO=your-hf-username/pii-guard-tagger
HF_TOKEN=
